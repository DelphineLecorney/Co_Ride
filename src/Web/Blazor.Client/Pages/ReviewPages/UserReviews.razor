@page "/reviews/{UserId:guid}"

<PageTitle>Avis reçus</PageTitle>

@if (_loading)
{
    <p>Chargement...</p>
}
else if (!_reviews.Any())
{
    <div class="alert alert-info">Aucun avis pour le moment.</div>
}
else
{
    <h4 class="mb-3">
        @_reviews.Count avis —
        <span class="text-warning">
            @string.Concat(Enumerable.Repeat("★", (int)Math.Round(_average)))
        </span>
        <small class="text-muted fs-6">@_average.ToString("0.0") / 5</small>
    </h4>

    @foreach (var review in _reviews)
    {
        <div class="card mb-3 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-warning fs-5">
                        @string.Concat(Enumerable.Repeat("★", review.Rating))
                        @string.Concat(Enumerable.Repeat("☆", 5 - review.Rating))
                    </span>
                    <small class="text-muted">
                        @review.CreatedAt.ToString("dd/MM/yyyy")
                    </small>
                </div>
                @if (!string.IsNullOrEmpty(review.Comment))
                {
                    <p class="mb-0">@review.Comment</p>
                }
                <small class="text-muted">
                    Par un @(review.ReviewerType == "Driver" ? "conducteur" : "passager")
                </small>
            </div>
        </div>
    }
}