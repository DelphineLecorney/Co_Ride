
@page "/profile/edit"
@using Microsoft.AspNetCore.Authorization
@using Blazor.Client.Pages.ProfilePages
@attribute [Authorize]

<PageTitle>Modifier mon profil</PageTitle>

<h2>Modifier mon profil</h2>

@if (_loading)
{
    <p>Chargement...</p>
}
else
{
    <EditForm Model="_model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label>Prénom</label>
            <InputText @bind-Value="_model.FirstName" class="form-control" />
        </div>

        <div class="form-group">
            <label>Nom</label>
            <InputTextArea @bind-Value="_model.LastName" class="form-control" rows="3" />
        </div>

        <div class="form-group">
            <label>Bio</label>
            <InputTextArea @bind-Value="_model.Bio" class="form-control" rows="3" />
        </div>

        <div class="form-group">
            <label>Téléphone</label>
            <InputText @bind-Value="_model.PhoneNumber" class="form-control" />
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <p class="text-danger">@_errorMessage</p>
        }

        <button type="submit" disabled="@_saving">
            @(_saving ? "Enregistrement..." : "Sauvegarder")
        </button>

        <button type="button" @onclick="Cancel">Annuler</button>

    </EditForm>
}

